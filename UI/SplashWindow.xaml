<Window x:Class="RevitExcelLink.UI.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helora BIM" Width="680" Height="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" Opacity="0"
        FontFamily="Gotham Rounded Book, Gotham Rounded, Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Turquoise" Color="#009E99"/>
        <SolidColorBrush x:Key="Turquoise50" Color="#80CFCC"/>
    </Window.Resources>

    <!-- Marge pour l'ombre portée -->
    <Grid Margin="20">
        <Border CornerRadius="16" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="#021F24"/>
            </Border.Effect>
            <Border.Background>
                <RadialGradientBrush Center="0.85,0.15" GradientOrigin="0.85,0.15" RadiusX="0.9" RadiusY="1.1">
                    <GradientStop Color="#0B5A66" Offset="0"/>
                    <GradientStop Color="#044550" Offset="0.55"/>
                    <GradientStop Color="#033A44" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>

            <Grid x:Name="Root">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,640,360" RadiusX="16" RadiusY="16"/>
                </Grid.Clip>

                <!-- Grand sigle +| en arrière-plan (élément graphique de la charte) -->
                <Viewbox x:Name="BigSigle" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Width="360" Height="298" Margin="0,0,-80,0" Stretch="Uniform">
                    <Viewbox.RenderTransform>
                        <TranslateTransform x:Name="SigleShift" X="60"/>
                    </Viewbox.RenderTransform>
                    <Path Fill="{StaticResource Turquoise}" Data="M99.6,86.5L99.6,86.5c2.8,0,5.1-2.3,5.1-5.1V5.1c0-2.8-2.3-5.1-5.1-5.1h0c-2.8,0-5.1,2.3-5.1,5.1v76.2C94.5,84.2,96.8,86.5,99.6,86.5z M81.4,38.2h-33v-33c0-2.8-2.3-5.1-5.1-5.1c-2.8,0-5.1,2.3-5.1,5.1v33h-33c-2.8,0-5.1,2.3-5.1,5.1c0,2.8,2.3,5.1,5.1,5.1h33v33c0,2.8,2.3,5.1,5.1,5.1c2.8,0,5.1-2.3,5.1-5.1v-33h33c2.8,0,5.1-2.3,5.1-5.1S84.3,38.2,81.4,38.2z"/>
                </Viewbox>

                <!-- Petites croix décoratives -->
                <Canvas IsHitTestVisible="False">
                    <TextBlock x:Name="Cross1" Text="+" Foreground="{StaticResource Turquoise50}" FontSize="22" Canvas.Left="44" Canvas.Top="30" Opacity="0"/>
                    <TextBlock x:Name="Cross2" Text="+" Foreground="{StaticResource Turquoise50}" FontSize="14" Canvas.Left="300" Canvas.Top="300" Opacity="0"/>
                </Canvas>

                <!-- Contenu -->
                <StackPanel VerticalAlignment="Center" Margin="56,0,0,10" HorizontalAlignment="Left">
                    <Image x:Name="Logo" Source="pack://application:,,,/RevitExcelLink;component/UI/Assets/helora-logo-white.png"
                           Width="270" HorizontalAlignment="Left" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"
                           RenderTransformOrigin="0,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="0.94" ScaleY="0.94"/>
                        </Image.RenderTransform>
                    </Image>

                    <Rectangle x:Name="Accent" Height="3" Width="0" HorizontalAlignment="Left" Fill="{StaticResource Turquoise}"
                               RadiusX="1.5" RadiusY="1.5" Margin="0,30,0,22"/>

                    <StackPanel x:Name="Product" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="ProductShift" Y="10"/>
                        </StackPanel.RenderTransform>
                        <TextBlock Foreground="White" FontSize="30"
                                   FontFamily="Gotham Rounded Light, Gotham Rounded, Segoe UI Light">
                            <Run Text="Helora"/><Run Text=" BIM" Foreground="{StaticResource Turquoise50}"/>
                        </TextBlock>
                        <TextBlock Text="EXCEL LINK  ·  NUMÉROTATION DES LOCAUX" Foreground="{StaticResource Turquoise50}"
                                   FontSize="11" FontWeight="SemiBold" Margin="2,6,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bas : statut, version, barre de progression -->
                <DockPanel VerticalAlignment="Bottom" Margin="56,0,32,22">
                    <TextBlock x:Name="TxtVersion" DockPanel.Dock="Right" Foreground="#6FA7AD" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Chargement des outils BIM…" Foreground="#9CC7CB" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid VerticalAlignment="Bottom" Height="4">
                    <Rectangle Fill="#0E5C68"/>
                    <Rectangle x:Name="Progress" HorizontalAlignment="Left" Width="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#80CFCC" Offset="0"/>
                                <GradientStop Color="#009E99" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
