<Window x:Class="RevitExcelLink.UI.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helora BIM – Excel Link – Aperçu de l'import" Width="1250" Height="680" MinWidth="800" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitExcelLink;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="HeloraWindow"/>
    </Window.Style>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource HeaderBand}">
            <DockPanel>
                <ContentControl ContentTemplate="{StaticResource HeloraSigle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock DockPanel.Dock="Right" Text="EXCEL LINK  ·  IMPORT EXCEL → REVIT" Foreground="{StaticResource HeloraTurquoise50}"
                           FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Foreground="White" FontFamily="{StaticResource HeloraTitleFont}" FontSize="22" VerticalAlignment="Center"><Run Text="Helora"/><Run Text=" BIM" Foreground="{StaticResource HeloraTurquoise50}"/></TextBlock>
            </DockPanel>
        </Border>
    <DockPanel Margin="16,12,16,12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Afficher :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CbFilter" Width="220" SelectedIndex="0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Tout"/>
                    <ComboBoxItem Content="Modifications applicables"/>
                    <ComboBoxItem Content="Conflits"/>
                    <ComboBoxItem Content="Erreurs, lecture seule, introuvables"/>
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="TxtSummary" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource HeloraDark}"/>
        </DockPanel>

        <TextBlock x:Name="TxtWarnings" DockPanel.Dock="Top" Foreground="{StaticResource HeloraOrange}" TextWrapping="Wrap" Margin="0,0,0,6"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Tout cocher" Style="{StaticResource GhostButton}" Click="CheckAll_Click"/>
            <Button DockPanel.Dock="Left" Content="Tout décocher" Style="{StaticResource GhostButton}" Click="UncheckAll_Click"/>
            <TextBlock DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource HeloraMuted}"
                       Text="Les conflits sont décochés par défaut. Tout est annulable en une fois avec Ctrl+Z dans Revit."/>
            <Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" x:Name="BtnApply" Content="Appliquer" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
        </DockPanel>

        <DataGrid x:Name="ChangesGrid" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource HeloraLine}"
                  BorderBrush="{StaticResource HeloraLine}" Background="White" RowBackground="White"
                  AlternatingRowBackground="#F7FBFB" Foreground="{StaticResource HeloraDark}"
                  SelectionMode="Extended" RowHeight="24">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30" SortMemberPath="Apply">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Apply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanApply}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Statut" Width="95" SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Feuille" Binding="{Binding Sheet}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Id" Binding="{Binding ElementIdText}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Élément" Binding="{Binding ElementLabel}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Paramètre" Binding="{Binding ParamName}" Width="1.5*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Valeur actuelle (Revit)" Binding="{Binding OldValue}" Width="1.3*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Nouvelle valeur (Excel)" Binding="{Binding NewValue}" Width="1.3*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Remarque" Binding="{Binding Message}" Width="3*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
    </DockPanel>
</Window>
