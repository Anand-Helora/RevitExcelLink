<Window x:Class="RevitExcelLink.UI.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importer depuis Excel – aperçu des modifications" Width="1250" Height="680" MinWidth="800" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Afficher :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CbFilter" Width="220" SelectedIndex="0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Tout"/>
                    <ComboBoxItem Content="Modifications applicables"/>
                    <ComboBoxItem Content="Conflits"/>
                    <ComboBoxItem Content="Erreurs, lecture seule, introuvables"/>
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="TxtSummary" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </DockPanel>

        <TextBlock x:Name="TxtWarnings" DockPanel.Dock="Top" Foreground="#E65100" TextWrapping="Wrap" Margin="0,0,0,6"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Tout cocher" Click="CheckAll_Click"/>
            <Button DockPanel.Dock="Left" Content="Tout décocher" Margin="6,0,0,0" Click="UncheckAll_Click"/>
            <TextBlock DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#555"
                       Text="Les conflits sont décochés par défaut. Tout est annulable en une fois avec Ctrl+Z dans Revit."/>
            <Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True" Margin="6,0,0,0"/>
            <Button DockPanel.Dock="Right" x:Name="BtnApply" Content="Appliquer" IsDefault="True" FontWeight="SemiBold" Click="Apply_Click"/>
        </DockPanel>

        <DataGrid x:Name="ChangesGrid" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0"
                  SelectionMode="Extended" RowHeight="22">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30" SortMemberPath="Apply">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Apply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanApply}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Statut" Width="95" SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Feuille" Binding="{Binding Sheet}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Id" Binding="{Binding ElementIdText}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Élément" Binding="{Binding ElementLabel}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Paramètre" Binding="{Binding ParamName}" Width="1.5*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Valeur actuelle (Revit)" Binding="{Binding OldValue}" Width="1.3*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Nouvelle valeur (Excel)" Binding="{Binding NewValue}" Width="1.3*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Remarque" Binding="{Binding Message}" Width="3*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
