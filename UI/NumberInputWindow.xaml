<Window x:Class="RevitExcelLink.UI.NumberInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helora BIM – Aller au numéro" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitExcelLink;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="HeloraWindow"/>
    </Window.Style>
    <StackPanel Margin="18,16,18,14">
        <TextBlock Text="ALLER AU NUMÉRO" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="TxtInfo" TextWrapping="Wrap" Foreground="{StaticResource HeloraMuted}" Margin="0,0,0,8"/>
        <DockPanel>
            <TextBlock x:Name="TxtPrefix" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0"
                       FontFamily="{StaticResource HeloraTitleFont}" Foreground="{StaticResource HeloraDark}"/>
            <TextBox x:Name="TxtNumber" FontSize="18" Padding="8,4"/>
        </DockPanel>
        <TextBlock x:Name="TxtError" Foreground="{StaticResource HeloraOrange}" Margin="0,6,0,0" Visibility="Collapsed"/>
        <DockPanel LastChildFill="False" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
