<Window x:Class="RevitExcelLink.UI.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel Link – Exporter vers Excel" Width="1180" Height="740" MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitExcelLink;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="ParamTemplate">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Display}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="HeloraWindow"/>
    </Window.Style>

    <DockPanel>
        <!-- ===== Bandeau ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource HeaderBand}">
            <DockPanel>
                <ContentControl ContentTemplate="{StaticResource HeloraSigle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock DockPanel.Dock="Right" Text="EXPORT REVIT → EXCEL" Foreground="{StaticResource HeloraTurquoise50}"
                           FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="Excel Link" Foreground="White" FontFamily="{StaticResource HeloraTitleFont}" FontSize="22" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ===== Pied ===== -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HeloraLine}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel x:Name="ProfilePanel" DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Charger un profil…" Click="LoadProfile_Click"/>
                    <Button Content="Enregistrer le profil…" Margin="6,0,0,0" Click="SaveProfile_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatus" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource HeloraMuted}"/>
                <Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="EXPORTER" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Export_Click"/>
                <CheckBox x:Name="CbOpen" DockPanel.Dock="Right" Content="Ouvrir le fichier après l'export" IsChecked="True" Margin="0,0,14,0"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="16,10,16,0" SelectionChanged="Tabs_SelectionChanged">
            <!-- =================== CATÉGORIES =================== -->
            <TabItem x:Name="TabCategories" Header="CATÉGORIES">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="PORTÉE" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <RadioButton x:Name="RbModel" GroupName="Scope" Content="Tout le modèle" IsChecked="True" Margin="0,0,14,0" Checked="Scope_Changed"/>
                        <RadioButton x:Name="RbView" GroupName="Scope" Content="Vue active" Margin="0,0,14,0" Checked="Scope_Changed"/>
                        <RadioButton x:Name="RbSelection" GroupName="Scope" Content="Sélection courante" Margin="0,0,28,0" Checked="Scope_Changed"/>
                        <CheckBox x:Name="CbByType" Content="Une ligne par type (paramètres de type uniquement)"
                                  Checked="ByType_Changed" Unchecked="ByType_Changed"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Catégories -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="1 · CATÉGORIES" Style="{StaticResource SectionTitle}"/>
                                <TextBox x:Name="TxtCatSearch" DockPanel.Dock="Top" Margin="0,0,0,6" ToolTip="Rechercher une catégorie" TextChanged="CatSearch_Changed"/>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Tout cocher" Style="{StaticResource GhostButton}" Click="CheckAllCats_Click"/>
                                    <Button Content="Tout décocher" Style="{StaticResource GhostButton}" Click="UncheckAllCats_Click"/>
                                </StackPanel>
                                <ListBox x:Name="LstCategories" ItemsSource="{Binding Categories}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Display}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Paramètres disponibles -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="2 · PARAMÈTRES DISPONIBLES" Style="{StaticResource SectionTitle}"/>
                                <TextBox x:Name="TxtParamSearch" DockPanel.Dock="Top" Margin="0,0,0,6" ToolTip="Rechercher un paramètre" TextChanged="ParamSearch_Changed"/>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox x:Name="CbShowInstance" Content="Occurrence" IsChecked="True" Margin="0,0,12,0" Click="ParamFilter_Click"/>
                                    <CheckBox x:Name="CbShowType" Content="Type" IsChecked="True" Margin="0,0,12,0" Click="ParamFilter_Click"/>
                                    <CheckBox x:Name="CbShowReadOnly" Content="Lecture seule" IsChecked="True" Click="ParamFilter_Click"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource HeloraTurquoise}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Occurrence" Margin="0,0,14,0" Foreground="{StaticResource HeloraMuted}"/>
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource HeloraTurquoise50}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Type" Margin="0,0,14,0" Foreground="{StaticResource HeloraMuted}"/>
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource HeloraOrange}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Lecture seule" Foreground="{StaticResource HeloraMuted}"/>
                                </StackPanel>
                                <ListBox x:Name="LstAvailable" ItemsSource="{Binding Available}" SelectionMode="Extended"
                                         ItemTemplate="{StaticResource ParamTemplate}" MouseDoubleClick="Available_DoubleClick"/>
                            </DockPanel>
                        </Border>

                        <!-- Flèches -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button Content="→" FontSize="15" Padding="10,2" ToolTip="Ajouter" Click="Add_Click"/>
                            <Button Content="←" FontSize="15" Padding="10,2" ToolTip="Retirer" Margin="0,6,0,0" Click="Remove_Click"/>
                            <Button Content="⇉" FontSize="15" Padding="10,2" ToolTip="Ajouter tous les paramètres affichés" Margin="0,18,0,0" Click="AddAll_Click"/>
                            <Button Content="⇇" FontSize="15" Padding="10,2" ToolTip="Tout retirer" Margin="0,6,0,0" Click="RemoveAll_Click"/>
                        </StackPanel>

                        <!-- Colonnes exportées -->
                        <Border Grid.Column="3" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="3 · COLONNES EXPORTÉES (DANS CET ORDRE)" Style="{StaticResource SectionTitle}"/>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="↑ Monter" Style="{StaticResource GhostButton}" Click="Up_Click"/>
                                    <Button Content="↓ Descendre" Style="{StaticResource GhostButton}" Click="Down_Click"/>
                                </StackPanel>
                                <ListBox x:Name="LstSelected" ItemsSource="{Binding Selected}" SelectionMode="Extended"
                                         ItemTemplate="{StaticResource ParamTemplate}" MouseDoubleClick="Selected_DoubleClick"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- =================== NOMENCLATURES =================== -->
            <TabItem x:Name="TabSchedules" Header="NOMENCLATURES">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="MODE D'EXPORT" Style="{StaticResource SectionTitle}"/>
                            <RadioButton x:Name="RbSchedEditable" GroupName="SchedMode" IsChecked="True" Margin="0,2">
                                <TextBlock><Run FontWeight="SemiBold" Text="Modifiable"/><Run Foreground="{StaticResource HeloraMuted}" Text="  – une ligne par élément, colonnes de la nomenclature, réimportable dans Revit"/></TextBlock>
                            </RadioButton>
                            <RadioButton x:Name="RbSchedFormatted" GroupName="SchedMode" Margin="0,2">
                                <TextBlock><Run FontWeight="SemiBold" Text="Mise en forme"/><Run Foreground="{StaticResource HeloraMuted}" Text="  – identique à l'affichage Revit (titres, regroupements, totaux), "/><Run Foreground="{StaticResource HeloraOrange}" Text="non réimportable"/></TextBlock>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="NOMENCLATURES DU PROJET" Style="{StaticResource SectionTitle}"/>
                                <TextBox x:Name="TxtSchedSearch" DockPanel.Dock="Top" Margin="0,0,0,6" ToolTip="Rechercher une nomenclature" TextChanged="SchedSearch_Changed"/>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Tout cocher" Style="{StaticResource GhostButton}" Click="CheckAllSched_Click"/>
                                    <Button Content="Tout décocher" Style="{StaticResource GhostButton}" Click="UncheckAllSched_Click"/>
                                </StackPanel>
                                <ListBox x:Name="LstSchedules" ItemsSource="{Binding Schedules}" SelectionChanged="Schedule_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                <TextBlock><Run Text="{Binding Info.Name, Mode=OneWay}"/><Run Foreground="{StaticResource HeloraMuted}" Text="{Binding KindSuffix, Mode=OneWay}"/></TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="APERÇU DES COLONNES" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="TxtSchedInfo" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource HeloraMuted}"
                                           Margin="0,0,0,6" Text="Cliquez sur une nomenclature pour voir les colonnes exportées."/>
                                <TextBlock x:Name="TxtSchedSkipped" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource HeloraOrange}" Margin="0,6,0,0"/>
                                <ListBox x:Name="LstSchedColumns" ItemsSource="{Binding ScheduleColumns}" ItemTemplate="{StaticResource ParamTemplate}"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
