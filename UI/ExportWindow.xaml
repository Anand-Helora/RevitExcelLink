<Window x:Class="RevitExcelLink.UI.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exporter vers Excel" Width="1150" Height="700" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <DataTemplate x:Key="ParamTemplate">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
                <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}"
                        BorderBrush="#80000000" BorderThickness="0.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Display}"/>
            </StackPanel>
        </DataTemplate>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="32"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Portée et mode -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Portée :" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <RadioButton x:Name="RbModel" GroupName="Scope" Content="Tout le modèle" IsChecked="True"
                         VerticalAlignment="Center" Margin="0,0,12,0" Checked="Scope_Changed"/>
            <RadioButton x:Name="RbView" GroupName="Scope" Content="Vue active"
                         VerticalAlignment="Center" Margin="0,0,12,0" Checked="Scope_Changed"/>
            <RadioButton x:Name="RbSelection" GroupName="Scope" Content="Sélection courante"
                         VerticalAlignment="Center" Margin="0,0,24,0" Checked="Scope_Changed"/>
            <CheckBox x:Name="CbByType" Content="Une ligne par type (paramètres de type uniquement)"
                      VerticalAlignment="Center" Checked="ByType_Changed" Unchecked="ByType_Changed"/>
        </StackPanel>

        <!-- Boutons du bas -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Charger un profil…" Click="LoadProfile_Click"/>
            <Button DockPanel.Dock="Left" Content="Enregistrer le profil…" Margin="6,0,0,0" Click="SaveProfile_Click"/>
            <TextBlock x:Name="TxtStatus" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#555"/>
            <Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True" Margin="6,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Exporter…" IsDefault="True" FontWeight="SemiBold" Click="Export_Click"/>
            <CheckBox x:Name="CbOpen" DockPanel.Dock="Right" Content="Ouvrir le fichier après l'export"
                      IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- Catégories -->
            <GroupBox Grid.Column="0" Header="1. Catégories" Margin="0,0,6,0">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Rechercher :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtCatSearch" TextChanged="CatSearch_Changed"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Tout cocher" Click="CheckAllCats_Click"/>
                        <Button Content="Tout décocher" Margin="6,0,0,0" Click="UncheckAllCats_Click"/>
                    </StackPanel>
                    <ListBox x:Name="LstCategories" ItemsSource="{Binding Categories}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Display}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <!-- Paramètres disponibles -->
            <GroupBox Grid.Column="1" Header="2. Paramètres disponibles" Margin="0,0,6,0">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Rechercher :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtParamSearch" TextChanged="ParamSearch_Changed"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="CbShowInstance" Content="Occurrence" IsChecked="True" Margin="0,0,10,0" Click="ParamFilter_Click"/>
                        <CheckBox x:Name="CbShowType" Content="Type" IsChecked="True" Margin="0,0,10,0" Click="ParamFilter_Click"/>
                        <CheckBox x:Name="CbShowReadOnly" Content="Lecture seule" IsChecked="True" Click="ParamFilter_Click"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Width="10" Height="10" Background="#4CAF50" Margin="0,0,4,0"/>
                        <TextBlock Text="Occurrence" Margin="0,0,12,0"/>
                        <Border Width="10" Height="10" Background="#FFC107" Margin="0,0,4,0"/>
                        <TextBlock Text="Type" Margin="0,0,12,0"/>
                        <Border Width="10" Height="10" Background="#E57373" Margin="0,0,4,0"/>
                        <TextBlock Text="Lecture seule"/>
                    </StackPanel>
                    <ListBox x:Name="LstAvailable" ItemsSource="{Binding Available}" SelectionMode="Extended"
                             ItemTemplate="{StaticResource ParamTemplate}" MouseDoubleClick="Available_DoubleClick"/>
                </DockPanel>
            </GroupBox>

            <!-- Flèches -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button Content="→" FontSize="16" ToolTip="Ajouter" Click="Add_Click"/>
                <Button Content="←" FontSize="16" ToolTip="Retirer" Margin="0,6,0,0" Click="Remove_Click"/>
                <Button Content="⇉" FontSize="16" ToolTip="Ajouter tous les paramètres affichés" Margin="0,18,0,0" Click="AddAll_Click"/>
                <Button Content="⇇" FontSize="16" ToolTip="Tout retirer" Margin="0,6,0,0" Click="RemoveAll_Click"/>
            </StackPanel>

            <!-- Paramètres exportés -->
            <GroupBox Grid.Column="3" Header="3. Colonnes exportées (dans cet ordre)">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="↑ Monter" Click="Up_Click"/>
                        <Button Content="↓ Descendre" Margin="6,0,0,0" Click="Down_Click"/>
                    </StackPanel>
                    <ListBox x:Name="LstSelected" ItemsSource="{Binding Selected}" SelectionMode="Extended"
                             ItemTemplate="{StaticResource ParamTemplate}" MouseDoubleClick="Selected_DoubleClick"/>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
