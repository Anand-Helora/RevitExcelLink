<Window x:Class="RevitExcelLink.UI.NumberingPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helora BIM – Numérotation" Width="310" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitExcelLink;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="HeloraWindow"/>
    </Window.Style>

    <StackPanel>
        <Border Background="{StaticResource HeloraDark}" Padding="14,9">
            <DockPanel>
                <ContentControl ContentTemplate="{StaticResource HeloraSigle}" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ContentControl.LayoutTransform>
                        <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                    </ContentControl.LayoutTransform>
                </ContentControl>
                <TextBlock x:Name="TxtCount" DockPanel.Dock="Right" Foreground="{StaticResource HeloraTurquoise50}" VerticalAlignment="Center" FontSize="11"/>
                <TextBlock Foreground="White" FontSize="13" VerticalAlignment="Center"><Run Text="Helora"/><Run Text=" BIM" Foreground="{StaticResource HeloraTurquoise50}"/><Run Text="  ·  Numérotation"/></TextBlock>
            </DockPanel>
        </Border>

        <StackPanel Margin="14,12,14,14">
            <TextBlock Text="PROCHAIN LOCAL" Style="{StaticResource SectionTitle}" Margin="0,0,0,0"/>
            <TextBlock x:Name="TxtNumber" FontSize="30" Foreground="{StaticResource HeloraDark}" FontFamily="{StaticResource HeloraTitleFont}"/>
            <TextBlock x:Name="TxtSub" Foreground="{StaticResource HeloraMuted}" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <UniformGrid Columns="2" Margin="0,0,0,8">
                <Button Content="−  Précédent" Margin="0,0,4,0" Click="Previous_Click" ToolTip="Revenir au numéro précédent"/>
                <Button Content="Sauter  ⏭" Margin="4,0,0,0" Style="{StaticResource PrimaryButton}" Click="Skip_Click" ToolTip="Passer ce numéro"/>
            </UniformGrid>

            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Aller" Margin="8,0,0,0" Click="GoTo_Click"/>
                <TextBlock x:Name="TxtPrefix" VerticalAlignment="Center" Foreground="{StaticResource HeloraMuted}" Margin="0,0,4,0"/>
                <TextBox x:Name="TxtGoTo" ToolTip="Aller directement à ce numéro (les numéros intermédiaires sont sautés)" KeyDown="GoTo_KeyDown"/>
            </DockPanel>
            <TextBlock x:Name="TxtError" Foreground="{StaticResource HeloraOrange}" Visibility="Collapsed" Margin="0,0,0,4"/>

            <TextBlock Text="DERNIERS LOCAUX" Style="{StaticResource SectionTitle}" Margin="0,10,0,4"/>
            <Border Style="{StaticResource Card}" Padding="8,6" MinHeight="64">
                <ItemsControl x:Name="LstHistory">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <UniformGrid Columns="2" Margin="0,12,0,0">
                <Button x:Name="BtnUndo" Content="↶  Annuler le dernier" Margin="0,0,4,0" Click="Undo_Click"
                        ToolTip="Remet le dernier local et ses éléments dans leur état d'avant"/>
                <Button Content="✓  Terminer" Margin="4,0,0,0" Click="Finish_Click"
                        Background="{StaticResource HeloraDark}" Foreground="White"/>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Border Width="14" Height="14" CornerRadius="3" Background="#FAD6DA" BorderBrush="#E8B4BA" BorderThickness="1" Margin="0,0,5,0"/>
                <TextBlock Text="À numéroter" Foreground="{StaticResource HeloraMuted}" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <Border Width="14" Height="14" CornerRadius="3" Background="#CDEED4" BorderBrush="#A6D8B1" BorderThickness="1" Margin="0,0,5,0"/>
                <TextBlock Text="Numéroté" Foreground="{StaticResource HeloraMuted}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Cliquez les locaux dans la vue. Échap dans la vue = terminer." Foreground="{StaticResource HeloraMuted}"
                       FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </StackPanel>
</Window>
