<Window x:Class="RevitExcelLink.UI.FillElementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helora BIM – Remplir les éléments depuis les locaux" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitExcelLink;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="HeloraWindow"/>
    </Window.Style>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource HeaderBand}">
            <DockPanel>
                <ContentControl ContentTemplate="{StaticResource HeloraSigle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel>
                    <TextBlock Foreground="White" FontFamily="{StaticResource HeloraTitleFont}" FontSize="20"><Run Text="Helora"/><Run Text=" BIM" Foreground="{StaticResource HeloraTurquoise50}"/></TextBlock>
                    <TextBlock Text="REMPLIR LES ÉLÉMENTS DEPUIS LES LOCAUX" Foreground="{StaticResource HeloraTurquoise50}" FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HeloraLine}" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="REMPLIR" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Run_Click"/>
            </DockPanel>
        </Border>

        <StackPanel Margin="18,14,18,12">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource HeloraMuted}" Margin="0,0,0,12"
                       Text="Chaque équipement, appareil, mobilier ou détecteur reçoit le bloc, l'étage, le n° GMAO et le n° du local qui le contient. Les pièces peuvent se trouver dans ce modèle ou dans un modèle lié (architecture)."/>

            <TextBlock Text="ÉLÉMENTS À REMPLIR" Style="{StaticResource SectionTitle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="RbView" GroupName="Scope" Content="Visibles dans la vue active" IsChecked="True" Margin="0,0,14,0"/>
                <RadioButton x:Name="RbModel" GroupName="Scope" Content="Tout le modèle" Margin="0,0,14,0"/>
                <RadioButton x:Name="RbSelection" GroupName="Scope" Content="Sélection"/>
            </StackPanel>

            <TextBlock Text="OÙ CHERCHER LES LOCAUX" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox x:Name="CbLocal" Content="Pièces de ce modèle" Margin="0,2"/>
                    <ItemsControl x:Name="LstLinks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2">
                                    <TextBlock><Run Text="Lien : "/><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Foreground="{StaticResource HeloraMuted}" Text="{Binding Detail, Mode=OneWay}"/></TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <CheckBox x:Name="CbOverwrite" Content="Écraser les valeurs déjà remplies" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtParams" Foreground="{StaticResource HeloraMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="TxtError" Foreground="{StaticResource HeloraOrange}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</Window>
