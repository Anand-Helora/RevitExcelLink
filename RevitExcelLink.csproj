<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Une seule DLL pour Revit 2025, 2026 et 2027 :
    compilée en .NET 8 contre l'API 2025, elle se charge aussi dans Revit 2027 (.NET 10).
    Compiler :  dotnet build -c Release
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>RevitExcelLink</RootNamespace>
    <AssemblyName>RevitExcelLink</AssemblyName>
    <Version>1.10.0</Version>

    <!-- Copie les dépendances (ClosedXML…) dans le dossier de sortie -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>

    <!-- Versions de Revit dans lesquelles déployer après chaque compilation (séparées par ;) -->
    <DeployRevitVersions Condition="'$(DeployRevitVersions)' == ''">2025</DeployRevitVersions>
  </PropertyGroup>

  <ItemGroup>
    <!-- API Revit 2025 (références de compilation uniquement, Revit fournit les DLL) -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.*" ExcludeAssets="runtime" PrivateAssets="all" />

    <!-- Lecture / écriture Excel sans Excel installé (licence MIT) -->
    <PackageReference Include="ClosedXML" Version="0.104.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="RevitExcelLink.addin" CopyToOutputDirectory="Never" />
    <Resource Include="UI\Assets\*.png" />
  </ItemGroup>

  <!-- Déploiement automatique dans %AppData%\Autodesk\Revit\Addins\<version> (Revit doit être fermé) -->
  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' And '$(SkipDeploy)' != 'true'">
    <ItemGroup>
      <_RxlVersion Include="$(DeployRevitVersions)" />
      <_RxlAddinDir Include="@(_RxlVersion->'$(AppData)\Autodesk\Revit\Addins\%(Identity)')" />
      <_RxlFile Include="$(TargetDir)*.dll;$(TargetDir)*.deps.json;$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_RxlFile)" DestinationFolder="%(_RxlAddinDir.Identity)\RevitExcelLink"
          SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(ProjectDir)RevitExcelLink.addin" DestinationFolder="%(_RxlAddinDir.Identity)"
          SkipUnchangedFiles="true" ContinueOnError="true" />
    <Message Importance="high" Text="Add-in déployé dans : @(_RxlAddinDir)" />
  </Target>

</Project>
